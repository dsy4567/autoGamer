{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "baseUrl": ".",
        "paths": {},
        "lib": ["ESNext", "DOM"],
        "checkJs": true,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": false
    },
    "include": ["src/**/*", "userData.default/**/*"],
    "exclude": [
        "node_modules",
        "**/*.deprecated.*",
        "userData.default/chromeData/**"
    ]
}
