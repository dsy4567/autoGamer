{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node10",
        "baseUrl": ".",
        "paths": {},
        "ignoreDeprecations": "6.0",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "checkJs": true,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": false
    },
    "include": [
        "src/loader.js",
        "src/inject.js",
        "src/utils.js",
        "src/config.default.js",
        "src/loadUserConfig.js",
        "userData.default/**/*.js",
        "userData.default/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.deprecated.*",
        "userData.default/chromeData/**"
    ]
}
