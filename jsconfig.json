{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node10",
        "baseUrl": ".",
        "paths": {},
        "ignoreDeprecations": "6.0",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "checkJs": true,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": false
    },
    "include": ["src/*", "userData.default/*"],
    "exclude": [
        "node_modules",
        "**/*.deprecated.*",
        "userData.default/chromeData/**"
    ]
}
